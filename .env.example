VITE_API_URL=http://localhost:3000

# Native app (pnpm android): the phone can't reach "localhost" on your PC.
# Put the address in .env.android (not committed). Use the PC's Tailscale address (tailscale ip -4);
# the phone needs the Tailscale app connected to the same tailnet:
#   VITE_API_URL=http://100.x.y.z:3000
#   (emulator only: http://10.0.2.2:3000)
